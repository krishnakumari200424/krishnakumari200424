        "import tensorflow as tf\n",
        "from tensorflow.keras import datasets, layers, models\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "from sklearn.metrics import classification_report\n",
        "\n",
        "# Load the dataset\n",
        "(X_train, y_train), (X_test, y_test) = datasets.cifar10.load_data()\n",
        "\n",
        "print(\"Training data shape:\", X_train.shape)  # (50000, 32, 32, 3)\n",
        "print(\"Test data shape:\", X_test.shape)       # (10000, 32, 32, 3)\n",
        "print(\"Training labels shape:\", y_train.shape)  # (50000, 1)\n",
        "print(\"First 5 training labels:\", y_train[:5])\n",
        "\n",
        "# Convert labels from 2D to 1D array\n",
        "y_train = y_train.reshape(-1,)\n",
        "y_test = y_test.reshape(-1,)\n",
        "\n",
        "print(\"First 5 training labels (reshaped):\", y_train[:5])\n",
        "\n",
        "classes = [\"airplane\", \"automobile\", \"bird\", \"cat\", \"deer\",\n",
        "           \"dog\", \"frog\", \"horse\", \"ship\", \"truck\"]\n",
        "\n",
        "# Function to plot sample images with labels\n",
        "def plot_sample(X, y, index):\n",
        "    plt.figure(figsize=(5, 3))\n",
        "    plt.imshow(X[index])\n",
        "    plt.xlabel(classes[y[index]])\n",
        "    plt.xticks([])\n",
        "    plt.yticks([])\n",
        "    plt.show()\n",
        "\n",
        "# Plot some sample images\n",
        "plot_sample(X_train, y_train, 0)\n",
        "plot_sample(X_train, y_train, 1)\n",
        "\n",
        "# Normalize pixel values to range [0, 1]\n",
        "X_train = X_train / 255.0\n",
        "X_test = X_test / 255.0\n",
        "\n",
        "# Build a simple Artificial Neural Network (ANN)\n",
        "ann = models.Sequential([\n",
        "    layers.Flatten(input_shape=(32, 32, 3)),\n",
        "    layers.Dense(3000, activation='relu'),\n",
        "    layers.Dense(1000, activation='relu'),\n",
        "    layers.Dense(10, activation='softmax')\n",
        "])\n",
        "\n",
        "ann.compile(optimizer='SGD',\n",
        "            loss='sparse_categorical_crossentropy',\n",
        "            metrics=['accuracy'])\n",
        "\n",
        "print(\"Training ANN...\")\n",
        "ann.fit(X_train, y_train, epochs=5)\n",
        "\n",
        "# Predict and evaluate ANN\n",
        "y_pred_ann = ann.predict(X_test)\n",
        "y_pred_classes_ann = np.argmax(y_pred_ann, axis=1)\n",
        "\n",
        "print(\"ANN Classification Report:\\n\", classification_report(y_test, y_pred_classes_ann))\n",
        "\n",
        "# Build Convolutional Neural Network (CNN)\n",
        "cnn = models.Sequential([\n",
        "    layers.Conv2D(32, (3, 3), activation='relu', input_shape=(32, 32, 3)),\n",
        "    layers.MaxPooling2D((2, 2)),\n",
        "\n",
        "    layers.Conv2D(64, (3, 3), activation='relu'),\n",
        "    layers.MaxPooling2D((2, 2)),\n",
        "\n",
        "    layers.Flatten(),\n",
        "    layers.Dense(64, activation='relu'),\n",
        "    layers.Dense(10, activation='softmax')\n",
        "])\n",
        "\n",
        "cnn.compile(optimizer='adam',\n",
        "            loss='sparse_categorical_crossentropy',\n",
        "            metrics=['accuracy'])\n",
        "\n",
        "print(\"Training CNN...\")\n",
        "cnn.fit(X_train, y_train, epochs=10)\n",
        "\n",
        "# Evaluate CNN on test data\n",
        "test_loss, test_acc = cnn.evaluate(X_test, y_test)\n",
        "print(f\"CNN Test accuracy: {test_acc:.4f}\")\n",
        "\n",
        "# Predict and evaluate CNN\n",
        "y_pred_cnn = cnn.predict(X_test)\n",
        "y_pred_classes_cnn = np.argmax(y_pred_cnn, axis=1)\n",
        "\n",
        "print(\"CNN Classification Report:\\n\", classification_report(y_test, y_pred_classes_cnn))\n",
        "\n",
        "# Plot a test image with true and predicted label\n",
        "test_index = 3\n",
        "plot_sample(X_test, y_test, test_index)\n",
        "print(f\"True label: {classes[y_test[test_index]]}\")\n",
        "print(f\"Predicted label: {classes[y_pred_classes_cnn[test_index]]}\")\n"
      ]
